# Postgres = Neon (copy the JDBC string from Neon's dashboard; keep sslmode=require)
DATABASE_URL=jdbc:postgresql://YOUR-NEON-HOST.neon.tech/peerup?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Redis runs on the VM (this compose) — just set a strong password
REDIS_PASSWORD=

APP_JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://dialogbuddy.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
METERED_DOMAIN=speaking.metered.live
METERED_SECRET_KEY=
